<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
				<string>public.volume</string>
			</array>
		</dict>
	</array>
	<key>NSAppleEventsUsageDescription</key>
	<string>Diski asks Finder to show Get Info windows and to empty the Trash.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Diski shows and manages the files on your Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Diski shows and manages the files in your Documents folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Diski shows and manages the files in your Downloads folder.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Diski shows and manages the files on network volumes.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Diski shows and manages the files on external drives.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open in Diski</string>
			</dict>
			<key>NSMessage</key>
			<string>openInDiski</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>FilePath</string>
			</dict>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.folder</string>
				<string>public.item</string>
			</array>
		</dict>
	</array>
